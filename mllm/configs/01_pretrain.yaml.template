model:
  model_name_or_path: Qwen/Qwen3-4B
  mm_vision_hidden_size: null # REQUIRED
  mm_projector_hidden_size: 2048
  image_tokens: 128
  lora:
    enable: false

data:
  train_conversations_path: "/path/to/conversations/train.csv" # REQUIRED
  eval_conversations_path: "/path/to/conversations/valid.csv" # REQUIRED
  embeddings_path: "/path/to/embeddings" # REQUIRED
  feature_key: cls
  system_prompt: ""
  pooling: none
  noise_p: 1.0
  noise_sigma: 0.1

train:
  per_device_train_batch_size: 1
  gradient_accumulation_steps: 32
  num_train_epochs: 1
  logging_dir: "tensorboard"
  warmup_ratio: 0.03
  learning_rate: 1e-4
  min_lr: 1e-6