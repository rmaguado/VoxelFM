   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e699db38",
   "metadata": {},
   "outputs": [],
   "source": [
    "path = \"\"\n",
    "df = pd.read_json(path, lines=True)\n",
    "list(df.columns)\n",
    "it = df[\"iteration\"]\n",
    "print(\"max iteration: \", it.tolist()[-1])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a756e3bb",
   "metadata": {},
   "outputs": [],
   "source": [
    "s_iter, l_iter = None, None\n",
    "\n",
    "x = df[\"iteration\"]\n",
    "s = (x - s_iter).abs().idxmin() if s_iter is not None else None\n",
    "l = (x - l_iter).abs().idxmin() if l_iter is not None else None\n",
    "x = x[s:l]\n",
    "total_loss = df[\"total_loss\"][s:l]\n",
    "local_loss = df[\"dino_local_crops_loss\"][s:l]\n",
    "global_loss = df[\"dino_global_crops_loss\"][s:l]\n",
    "ibot_loss = df[\"ibot_loss\"][s:l]\n",
    "koleo_loss = df[\"koleo_loss\"][s:l]\n",
    "\n",
    "fig, ax = plt.subplots(1, 4, figsize=(16, 4))\n",
    "fig.tight_layout()\n",
    "\n",
    "ax[0].plot(x, local_loss)\n",
    "ax[0].set_title(\"Local Loss\")\n",
    "ax[0].set_xlabel(\"Iteration\")\n",
    "ax[0].grid()\n",
    "\n",
    "ax[1].plot(x, global_loss)\n",
    "ax[1].set_title(\"Global Loss\")\n",
    "ax[1].set_xlabel(\"Iteration\")\n",
    "ax[1].grid()\n",
    "\n",
    "ax[2].plot(x, ibot_loss)\n",
    "ax[2].set_title(\"IBot Loss\")\n",
    "ax[2].set_xlabel(\"Iteration\")\n",
    "ax[2].grid()\n",
    "\n",
    "ax[3].plot(x, total_loss)\n",
    "ax[3].set_title(\"Total Loss\")\n",
    "ax[3].set_xlabel(\"Iteration\")\n",
    "ax[3].grid()\n",
    "\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "55353753",
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.plot(x, koleo_loss)\n",
    "plt.title(\"Koleo Loss\")\n",
    "plt.xlabel(\"Iteration\")\n",
    "plt.grid()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
 ]
}
